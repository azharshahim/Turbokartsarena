{
  "name": "turbo-karts-arena",
  "version": "4.1.0-dev",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "preview:build": "node tools/build-preview.mjs",
    "preview:serve": "node tools/serve-preview.mjs",
    "test": "esbuild tools/tests.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/tests.cjs --log-level=error && node node_modules/.cache/tests.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.preview.json",
    "astc": "node tools/compress-astc.mjs",
    "test:browser": "node tools/preview-regression.mjs",
    "test:pwa": "node tools/pwa-regression.mjs",
    "icons:build": "node tools/generate-icons.mjs",
    "test:v2": "esbuild tools/tests-v2.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/tests-v2.cjs --log-level=error && node node_modules/.cache/tests-v2.cjs",
    "test:browser:v2": "node tools/browser-v2.mjs",
    "test:v3": "esbuild tools/tests-v3.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/tests-v3.cjs --log-level=error && node node_modules/.cache/tests-v3.cjs",
    "test:v4": "esbuild tools/tests-v4.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/tests-v4.cjs --log-level=error && node node_modules/.cache/tests-v4.cjs",
    "test:browser:android": "node tools/browser-android-startup.mjs",
    "test:browser:narrowing": "node tools/browser-narrowing.mjs",
    "test:browser:gpu": "node tools/browser-gpu-stability.mjs",
    "test:mission10": "esbuild tools/tests-mission10.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/tests-mission10.mjs --log-level=error && node node_modules/.cache/tests-mission10.mjs",
    "test:mission11": "esbuild tools/tests-mission11.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/tests-mission11.mjs --log-level=error && node node_modules/.cache/tests-mission11.mjs",
    "test:gyro": "esbuild tools/tests-gyro-stability.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/tests-gyro.mjs --log-level=error && node node_modules/.cache/tests-gyro.mjs",
    "test:mission12": "esbuild tools/tests-mission12.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/tests-mission12.mjs --log-level=error && node node_modules/.cache/tests-mission12.mjs",
    "test:build-id": "node tools/check-build-id.mjs",
    "test:browser:android:layout": "node tools/browser-android-landscape.mjs",
    "test:browser:mission11": "node tools/browser-mission11.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "expo": "~51.0.28",
    "expo-asset": "~10.0.10",
    "expo-gl": "~14.0.2",
    "expo-linear-gradient": "~13.0.2",
    "expo-sensors": "~13.0.9",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "@types/three": "^0.166.0",
    "esbuild": "^0.23.1",
    "playwright": "^1.47.2",
    "typescript": "^5.3.3"
  }
}
