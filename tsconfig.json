{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "target": "ES2020",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["react", "react-native"]
  },
  "include": ["src/ui", "src/game", "src/core", "src/render", "App.tsx", "index.js"]
}
